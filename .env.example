# Required for Telegram polling mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Optional. If absent, the agent uses deterministic dry-run providers.
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
# Drafting model. Defaults to claude-sonnet-5 when blank or absent.
ANTHROPIC_MODEL=
# Model for the self-review pass. Defaults to ANTHROPIC_MODEL when blank or absent.
ANTHROPIC_REVIEW_MODEL=

# Optional paths. Defaults are suitable when running from this project folder.
PA_AGENT_DB_PATH=./data/pa_agent.sqlite3
PA_AGENT_OBSIDIAN_VAULT=C:/path/to/your/ObsidianVault
PA_AGENT_OBSIDIAN_TASK_DIR=Projects/Active/Personal Assistant Agent Tasks

# Optional. Sign-off name used in dry-run draft outreach text.
PA_AGENT_SENDER_NAME=Your Name

